# Copy to .env.local for local development, and set the same two variables in the
# Vercel project settings. Both are server-side only: the Vite dev/preview proxy and
# the Vercel function in api/proxy.ts add the key in the X-API-Key header, so the key
# never reaches the browser. Do not give them a VITE_ prefix.
API_BASE_URL=
API_KEY=
